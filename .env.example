# Sentinel-12 Environment Configuration (.env)
# Copy to .env or export into your shell / CI environment

SENTINEL_BASE_URL=https://your-target-app.example.com
SENTINEL_ADMIN_SESSION=your_admin_session_cookie
SENTINEL_USER_A_SESSION=your_user_a_session_cookie
SENTINEL_USER_B_SESSION=your_user_b_session_cookie
SENTINEL_AGENCY_A_SESSION=your_agency_a_session_cookie
SENTINEL_AGENCY_B_SESSION=your_agency_b_session_cookie
SENTINEL_VERBOSE=false
SENTINEL_CONFIG_FILE=.sentinel
